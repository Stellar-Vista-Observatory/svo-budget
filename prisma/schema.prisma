generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectType {
  claimed
  catch_all
}

model Project {
  id               String        @id @default(uuid())
  name             String
  description      String?
  projectType      ProjectType
  qboAccountId     String?
  qboAccountName   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  categories       Category[]

  @@map("projects")
}

model FundingSource {
  id             String       @id @default(uuid())
  name           String
  color          String
  allocatedTotal Decimal      @db.Decimal(12, 2)
  qboClassId     String       @unique
  qboClassName   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  allocations    FundingAllocation[]
  actuals        Actual[]

  @@map("funding_sources")
}

model Category {
  id             String         @id @default(uuid())
  projectId      String
  name           String
  sortOrder      Int            @default(0)
  qboAccountId   String?        @unique
  qboAccountName String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetEntries  BudgetEntry[]
  actuals        Actual[]

  @@index([projectId])
  @@map("categories")
}

model BudgetEntry {
  id              String       @id @default(uuid())
  categoryId      String
  name            String
  estimatedAmount Decimal      @db.Decimal(12, 2) @default(0)
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  category        Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  allocations     FundingAllocation[]

  @@index([categoryId])
  @@map("budget_entries")
}

model FundingAllocation {
  id              String        @id @default(uuid())
  budgetEntryId   String
  fundingSourceId String
  allocatedAmount Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  budgetEntry     BudgetEntry   @relation(fields: [budgetEntryId], references: [id], onDelete: Cascade)
  fundingSource   FundingSource @relation(fields: [fundingSourceId], references: [id], onDelete: Cascade)

  @@unique([budgetEntryId, fundingSourceId])
  @@index([fundingSourceId])
  @@map("funding_allocations")
}

model Actual {
  id                 String        @id @default(uuid())
  categoryId         String
  fundingSourceId    String?
  amount             Decimal       @db.Decimal(12, 2)
  date               DateTime      @db.Date
  vendor             String?
  memo               String?
  qboTransactionId   String
  qboTransactionType String
  createdAt          DateTime      @default(now())
  category           Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  fundingSource      FundingSource? @relation(fields: [fundingSourceId], references: [id], onDelete: SetNull)

  @@unique([qboTransactionId, categoryId])
  @@index([categoryId])
  @@index([fundingSourceId])
  @@map("actuals")
}

model QboConnection {
  id              String    @id @default(uuid())
  realmId         String    @unique
  companyName     String
  accessToken     String
  refreshToken    String
  tokenExpiresAt  DateTime
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("qbo_connections")
}

enum Role {
  admin
  viewer
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @unique
  role      Role     @default(viewer)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_roles")
}
